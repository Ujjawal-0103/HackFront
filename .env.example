# Traceback Environment Configuration Template
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT. NEVER COMMIT ACTUAL CREDENTIALS.

# Node & Server Environment
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
WEB_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16 via Docker host port 5434)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5434/traceback_dev?schema=public"

# Redis Configuration (Job Queue for Ingestion)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GitHub App Authentication (Read-Only Minimum Scopes)
# Register at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH="./secrets/github-app-private-key.pem"
GITHUB_WEBHOOK_SECRET=

# LLM Provider Configuration (Advisory Grounding & Extraction)
# Provide at least one provider key for claim verification:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Application Theming (Default: light - light theme is non-negotiable default)
DEFAULT_THEME=light

# Model Context Protocol (MCP) Server Configuration
# Token obtained after registering/logging in via API or Web UI
TRACEBACK_API_URL=http://localhost:3001/api
TRACEBACK_API_TOKEN=
TRACEBACK_WORKSPACE_ID=
TRACEBACK_REQUEST_TIMEOUT_MS=15000

# Neo4j Graph Database (Sprint 4 Architecture Evaluation - Optional)
# Neo4j is optional; PostgreSQL Full-Text Search is the baseline evidence system
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tracebackpassword
NEO4J_DATABASE=neo4j


