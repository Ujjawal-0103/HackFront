datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Identity & Multi-Tenant Boundaries
model User {
  id           String            @id @default(uuid())
  email        String            @unique
  name         String
  avatarUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  WorkspaceMember[]
  verdicts     HumanVerdictRecord[]

  @@map("users")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  members               WorkspaceMember[]
  repositories          Repository[]
  gitHubInstallations   GitHubInstallation[]
  verificationSessions  VerificationSession[]
  reports               VerificationReport[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// 2. Repository & GitHub Metadata Boundaries
model GitHubInstallation {
  id             String    @id @default(uuid())
  workspaceId    String
  installationId Int       @unique // GitHub App Installation ID
  accountLogin   String    // e.g. "org-name" or "user-name"
  accountType    String    // "Organization" or "User"
  permissions    Json      // Snapshot of granted permissions
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("github_installations")
}

model Repository {
  id             String                @id @default(uuid())
  workspaceId    String
  githubRepoId   Int?                  @unique
  fullName       String                // e.g. "owner/repo"
  defaultBranch  String                @default("main")
  isPrivate      Boolean               @default(true)
  indexedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions       VerificationSession[]
  syncJobs       RepositorySyncJob[]
  commits        GitCommit[]
  pullRequests   PullRequest[]
  issues         Issue[]
  sourceRecords  SourceRecord[]

  @@unique([workspaceId, fullName])
  @@map("repositories")
}

// 3. Verification & Epistemological Claim Records
enum SessionStatus {
  PENDING
  ANALYZING
  REVIEWING
  COMPLETED
  FAILED
}

enum AIAssessmentConfidence {
  HIGH_SUPPORT
  PARTIAL_SUPPORT
  SPARSE_EVIDENCE
  CONTRADICTED
}

enum HumanVerdict {
  SUPPORTED
  CONTRADICTED
  UNVERIFIED
}

enum EvidenceSourceType {
  COMMIT
  PULL_REQUEST
  ISSUE
  DOCUMENTATION
  ADR
}

model VerificationSession {
  id             String        @id @default(uuid())
  workspaceId    String
  repositoryId   String
  explanation    String        @db.Text
  codeSnippet    String?       @db.Text
  targetFilePath String?
  status         SessionStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository     Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  claims         Claim[]
  reports        VerificationReport[]

  @@map("verification_sessions")
}

model Claim {
  id                    String                 @id @default(uuid())
  sessionId             String
  text                  String                 @db.Text
  targetSymbol          String?
  preliminaryConfidence AIAssessmentConfidence @default(SPARSE_EVIDENCE)
  humanVerdict          HumanVerdict?
  reviewNotes           String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  session               VerificationSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidence              EvidenceRecord[]
  assessments           ClaimAssessment[]
  humanVerdicts         HumanVerdictRecord[]

  @@map("claims")
}

model EvidenceRecord {
  id             String             @id @default(uuid())
  claimId        String
  sourceType     EvidenceSourceType
  referenceKey   String             // Commit SHA, PR #, Issue #
  title          String
  author         String
  timestamp      DateTime
  url            String             // Clickable GitHub URL
  snippet        String?            @db.Text
  filePath       String?
  lineStart      Int?
  lineEnd        Int?
  sourceRecordId String?
  createdAt      DateTime           @default(now())

  claim          Claim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sourceRecord   SourceRecord?      @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@index([sourceRecordId])
  @@map("evidence_records")
}

model SourceRecord {
  id           String             @id @default(uuid())
  repositoryId String
  sourceType   EvidenceSourceType
  externalId   String             // SHA, PR # as string, Issue # as string, or doc path
  referenceKey String             // Display key: e.g. "7f8a9b", "#42", "docs/ADR-001.md"
  title        String
  author       String
  url          String
  content      String             @db.Text
  snippet      String?            @db.Text
  filePath     String?
  lineStart    Int?
  lineEnd      Int?
  metadata     Json?
  recordedAt   DateTime           // When the commit/event actually happened
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  repository      Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  evidenceRecords EvidenceRecord[]

  @@unique([repositoryId, sourceType, externalId])
  @@index([repositoryId, sourceType])
  @@index([repositoryId, recordedAt])
  @@index([referenceKey])
  @@map("source_records")
}

model ClaimAssessment {
  id                String                 @id @default(uuid())
  claimId           String
  confidence        AIAssessmentConfidence
  rationale         String                 @db.Text
  modelIdentifier   String                 @default("heuristics-v1")
  evidenceRecordIds Json?                  // string[] of referenced EvidenceRecord IDs
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  claim             Claim                  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_assessments")
}

model HumanVerdictRecord {
  id          String       @id @default(uuid())
  claimId     String
  verdict     HumanVerdict
  reviewerId  String?
  reviewNotes String?      @db.Text
  decidedAt   DateTime     @default(now())

  claim       Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reviewer    User?        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([claimId])
  @@map("human_verdict_records")
}

model VerificationReport {
  id              String              @id @default(uuid())
  sessionId       String
  workspaceId     String
  summary         Json
  markdownContent String              @db.Text
  jsonPayload     Json
  createdAt       DateTime            @default(now())

  session         VerificationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([workspaceId])
  @@map("verification_reports")
}

// 4. Ingestion & Historical Provenance Boundaries
enum SyncStatus {
  PENDING
  SYNCING
  COMPLETED
  FAILED
}

enum SyncTrigger {
  MANUAL
  WEBHOOK
}

model RepositorySyncJob {
  id                String       @id @default(uuid())
  repositoryId      String
  status            SyncStatus   @default(PENDING)
  trigger           SyncTrigger  @default(MANUAL)
  commitsCount      Int          @default(0)
  pullRequestsCount Int          @default(0)
  issuesCount       Int          @default(0)
  errorMessage      String?      @db.Text
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  repository        Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, status])
  @@index([repositoryId, createdAt])
  @@map("repository_sync_jobs")
}

model GitCommit {
  id           String        @id @default(uuid())
  repositoryId String
  sha          String        // 40-character Git commit hash
  message      String        @db.Text
  authorName   String
  authorEmail  String?
  committedAt  DateTime
  url          String        // Clickable GitHub commit URL
  diffs        CommitDiff[]
  createdAt    DateTime      @default(now())

  repository   Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@map("git_commits")
}

model CommitDiff {
  id         String     @id @default(uuid())
  commitId   String
  filePath   String
  status     String     // "added", "modified", "removed", "renamed"
  additions  Int        @default(0)
  deletions  Int        @default(0)
  diffHunk   String?    @db.Text // Sanitized unified diff patch
  isBinary   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  commit     GitCommit  @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@unique([commitId, filePath])
  @@index([commitId])
  @@map("commit_diffs")
}

model PullRequest {
  id           String               @id @default(uuid())
  repositoryId String
  number       Int                  // GitHub PR # (e.g. 42)
  title        String
  body         String?              @db.Text
  author       String
  state        String               // "open", "closed", "merged"
  isMerged     Boolean              @default(false)
  mergedAt     DateTime?
  closedAt     DateTime?
  url          String               // Clickable GitHub PR URL
  comments     PullRequestComment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  repository   Repository           @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([repositoryId, createdAt])
  @@map("pull_requests")
}

model PullRequestComment {
  id              String      @id @default(uuid())
  pullRequestId   String
  githubCommentId String      // External GitHub comment ID as string to avoid 32-bit overflow
  author          String
  body            String      @db.Text
  createdAt       DateTime

  pullRequest     PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, githubCommentId])
  @@index([pullRequestId])
  @@map("pull_request_comments")
}

model Issue {
  id           String         @id @default(uuid())
  repositoryId String
  number       Int            // GitHub Issue #
  title        String
  body         String?        @db.Text
  author       String
  state        String         // "open", "closed"
  closedAt     DateTime?
  url          String         // Clickable GitHub Issue URL
  comments     IssueComment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  repository   Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([repositoryId, createdAt])
  @@map("issues")
}

model IssueComment {
  id              String   @id @default(uuid())
  issueId         String
  githubCommentId String   // External GitHub comment ID as string to avoid 32-bit overflow
  author          String
  body            String   @db.Text
  createdAt       DateTime

  issue           Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, githubCommentId])
  @@index([issueId])
  @@map("issue_comments")
}
