{
  "name": "traceback",
  "version": "0.1.0",
  "private": true,
  "description": "Human-supervised verification system for AI-generated code explanations",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prisma:generate": "pnpm --filter @traceback/api prisma:generate",
    "prisma:validate": "pnpm --filter @traceback/api prisma:validate",
    "prisma:migrate:dev": "pnpm --filter @traceback/api prisma:migrate:dev",
    "prisma:migrate:status": "pnpm --filter @traceback/api prisma:migrate:status"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
