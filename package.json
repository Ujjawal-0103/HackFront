{
  "name": "traceback",
  "version": "0.1.0",
  "private": true,
  "description": "Human-supervised verification system for AI-generated code explanations",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prisma:generate": "npm run prisma:generate --workspace=@traceback/api",
    "prisma:validate": "npm run prisma:validate --workspace=@traceback/api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=@traceback/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@traceback/api",
    "prisma:migrate:status": "npm run prisma:migrate:status --workspace=@traceback/api"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
